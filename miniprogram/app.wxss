/* app.wxss — 全局样式 */

/* WeUI 变量覆盖（可选） */
page {
  --weui-BG-0: #ededed;
  --weui-BG-1: #f7f7f7;
  --weui-BG-2: #ffffff;
  --weui-BRAND: #07C160;
  --weui-FG-0: #000000;
  --weui-FG-1: rgba(0,0,0,.55);
  --weui-FG-2: rgba(0,0,0,.3);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  background-color: var(--weui-BG-1);
  color: var(--weui-FG-0);
  font-size: 28rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04);
}

/* 页面容器 */
.page-container {
  padding-bottom: 40rpx;
}

/* 主按钮 */
.btn-primary {
  background: var(--weui-BRAND);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  line-height: 88rpx;
  text-align: center;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

/* 状态 Tag */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 36rpx;
}

.tag-open {
  background: #FFF1F0;
  color: #FA5151;
}

.tag-ack {
  background: #F2F2F2;
  color: #888;
}

.tag-active {
  background: #E8F8EE;
  color: #07C160;
}

/* 空态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--weui-FG-2);
  font-size: 28rpx;
}

/* 顶部间距 */
.section-title {
  font-size: 28rpx;
  color: var(--weui-FG-1);
  padding: 24rpx 24rpx 8rpx;
}
