/* pages/company/index.wxss */

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 24rpx 24rpx 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--weui-FG-0);
}

.section-sub {
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

/* 部门卡片 */
.dept-card {
  position: relative;
}

.dept-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.dept-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.dept-icon-eng {
  background: linear-gradient(135deg, #07C160, #06AD56);
}

.dept-icon-boiler {
  background: linear-gradient(135deg, #FF976A, #F56C6C);
}

.dept-icon-prod {
  background: linear-gradient(135deg, #409EFF, #337ecc);
}

.dept-icon-trans {
  background: linear-gradient(135deg, #67C23A, #4e9a2e);
}

.dept-icon-admin {
  background: linear-gradient(135deg, #909399, #6d7278);
}

.dept-icon-finance {
  background: linear-gradient(135deg, #E6A23C, #cf8a1e);
}

.dept-info {
  flex: 1;
}

.dept-name {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.dept-status {
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-normal {
  background: #e8f8ee;
  color: #07C160;
}

.status-warn {
  background: #fff3e0;
  color: #e6a23c;
}

.status-inactive {
  background: var(--weui-BG-1);
  color: var(--weui-FG-2);
}

/* 指标网格 */
.dept-metrics {
  display: flex;
  justify-content: space-around;
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--weui-BG-1);
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--weui-FG-0);
}

.metric-warn {
  color: #e6a23c;
}

.metric-label {
  font-size: 22rpx;
  color: var(--weui-FG-2);
  margin-top: 4rpx;
}

/* 预留卡片 */
.dept-card-placeholder {
  opacity: 0.6;
}

.placeholder-hint {
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

/* 摘要 */
.summary-row {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
}

.summary-row + .summary-row {
  border-top: 1rpx solid var(--weui-BG-1);
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-label {
  font-size: 24rpx;
  color: var(--weui-FG-2);
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
}
