<!-- pages/company/index.wxml -->

<!-- 登录加载中 -->
<view class="loading-page" wx:if="{{loading}}">
  <view class="loading-logo">康</view>
  <view class="loading-title">云南康洁</view>
  <view class="loading-sub">企业综合管理平台</view>
</view>

<!-- 主内容 -->
<view class="co-page" wx:else>

  <!-- 顶部区域 -->
  <view class="co-header">
    <view class="co-greeting">
      <view class="co-hello">你好，{{userInfo.displayName || '管理员'}}</view>
      <view class="co-date">{{yearMonth}}</view>
    </view>
    <view class="co-factory-pill" bindtap="onSwitchFactory">
      <text class="co-factory-name">{{currentFactoryName}}</text>
      <text class="co-factory-arrow">▾</text>
    </view>
  </view>

  <!-- 数据卡片 -->
  <view class="co-stats">
    <view class="co-stat-item">
      <text class="co-stat-num">{{stats.totalLogs}}</text>
      <text class="co-stat-label">本月更换</text>
    </view>
    <view class="co-stat-item">
      <text class="co-stat-num co-stat-warn" wx:if="{{stats.openAlerts > 0}}">{{stats.openAlerts}}</text>
      <text class="co-stat-num" wx:else>{{stats.openAlerts}}</text>
      <text class="co-stat-label">待处理报警</text>
    </view>
    <view class="co-stat-item">
      <text class="co-stat-num">{{stats.totalAlerts}}</text>
      <text class="co-stat-label">总报警数</text>
    </view>
    <view class="co-stat-item">
      <text class="co-stat-num">{{stats.totalPartsQty}}</text>
      <text class="co-stat-label">配件消耗</text>
    </view>
  </view>

  <!-- 部门入口 -->
  <view class="co-section-title">部门</view>

  <!-- 工程部 -->
  <view class="co-dept" bindtap="onGoEngineering">
    <view class="co-dept-left">
      <view class="co-dept-icon" style="background:#07C160;">工</view>
      <view class="co-dept-text">
        <text class="co-dept-name">工程部</text>
        <text class="co-dept-desc">设备维护 · 配件管理 · 阈值报警</text>
      </view>
    </view>
    <view class="co-dept-right">
      <view class="co-dept-badge {{engStatus === 'warn' ? 'badge-warn' : 'badge-ok'}}">{{engStatusText}}</view>
      <text class="co-dept-go">›</text>
    </view>
  </view>

  <!-- 锅炉房 -->
  <view class="co-dept" bindtap="onGoBoiler">
    <view class="co-dept-left">
      <view class="co-dept-icon" style="background:#E65100;">锅</view>
      <view class="co-dept-text">
        <text class="co-dept-name">锅炉房</text>
        <text class="co-dept-desc">运行数据 · 能耗统计 · 预警管理</text>
      </view>
    </view>
    <view class="co-dept-right">
      <view class="co-dept-badge badge-ok">已接入</view>
      <text class="co-dept-go">›</text>
    </view>
  </view>

  <!-- 业务部 -->
  <view class="co-dept" wx:if="{{canBusiness}}" bindtap="onGoBusiness">
    <view class="co-dept-left">
      <view class="co-dept-icon" style="background:#409EFF;">业</view>
      <view class="co-dept-text">
        <text class="co-dept-name">业务部</text>
        <text class="co-dept-desc">酒店地图 · 客户管理 · 业务拓展</text>
      </view>
    </view>
    <view class="co-dept-right">
      <view class="co-dept-badge badge-ok">已接入</view>
      <text class="co-dept-go">›</text>
    </view>
  </view>

  <!-- 即将接入 -->
  <view class="co-section-title" style="margin-top:32rpx;">即将接入</view>

  <view class="co-upcoming">
    <view class="co-upcoming-item">
      <view class="co-upcoming-icon" style="background:#67C23A;">产</view>
      <text>生产部</text>
    </view>
    <view class="co-upcoming-item">
      <view class="co-upcoming-icon" style="background:#67C23A;">运</view>
      <text>运输部</text>
    </view>
    <view class="co-upcoming-item">
      <view class="co-upcoming-icon" style="background:#909399;">综</view>
      <text>综合办</text>
    </view>
    <view class="co-upcoming-item">
      <view class="co-upcoming-icon" style="background:#E6A23C;">财</view>
      <text>财务</text>
    </view>
  </view>

</view>
