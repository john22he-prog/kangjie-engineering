/* pages/ai-report/index.wxss */
.page-container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.header-card {
  margin-bottom: 28rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.picker-label {
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.btn-primary {
  flex: 1;
  background: #07C160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  line-height: 2.2;
}

.stat-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-danger .stat-value {
  color: #F56C6C;
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.badge {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
}
.badge-danger { background: #F56C6C; }
.badge-success { background: #67C23A; }
.badge-info { background: #909399; }

.history-card { }
.history-row {
  display: flex;
  gap: 20rpx;
}
.history-item {
  flex: 1;
  text-align: center;
}
.history-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.history-val {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #555;
}

.section-list {
  margin-top: 12rpx;
}

.section-item {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-hint {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}
