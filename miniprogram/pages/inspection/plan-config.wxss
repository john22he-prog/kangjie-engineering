.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.form-label {
  font-size: 28rpx;
  color: var(--weui-FG-1);
  min-width: 160rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

/* 操作栏 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toolbar-info {
  font-size: 26rpx;
  color: var(--weui-FG-1);
}

.toolbar-btns {
  display: flex;
  gap: 24rpx;
}

.toolbar-link {
  font-size: 26rpx;
  color: var(--weui-BRAND);
}

.toolbar-link:active {
  opacity: 0.7;
}

/* 设备列表 */
.device-list {
  padding: 0 24rpx;
}

.device-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--weui-BG-1);
}

.device-item:last-child {
  border-bottom: none;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--weui-FG-2);
  border-radius: 8rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
}

.checkbox.checked {
  background: var(--weui-BRAND);
  border-color: var(--weui-BRAND);
}

.device-info {
  flex: 1;
}

.device-name {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.device-no {
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

/* 保存按钮 */
.save-bar {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}
