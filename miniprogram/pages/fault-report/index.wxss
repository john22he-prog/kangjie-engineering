.page-container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.loading-view {
  text-align: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: 30rpx;
  color: #999;
}

.hero {
  text-align: center;
  padding: 80rpx 0 60rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}

.hero-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.scan-btn {
  width: 560rpx;
  height: 100rpx;
  margin: 40rpx auto;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.35);
}

.scan-btn:active { opacity: 0.85; transform: scale(0.97); }

.scan-btn-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.required { color: #e74c3c; }

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.info-label { color: #999; }
.info-value { color: #333; font-weight: 500; }

.photo-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.photo-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon { font-size: 56rpx; color: #ccc; line-height: 1; }
.photo-add-text { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.remark-input {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.btn-group {
  margin-top: 40rpx;
  text-align: center;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.submit-btn.disabled {
  background: #ccc;
}

.rescan-link {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #576B95;
}

.success-view {
  text-align: center;
  padding: 120rpx 0;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 50%;
  background: #07C160;
  color: #fff;
  font-size: 64rpx;
  margin: 0 auto 32rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.success-desc {
  font-size: 28rpx;
  color: #999;
  margin: 16rpx 0 60rpx;
}
