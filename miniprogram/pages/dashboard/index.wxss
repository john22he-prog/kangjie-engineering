/* pages/dashboard/index.wxss */

/* 工厂切换栏 */
.factory-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  margin: 0 24rpx 8rpx;
  background: var(--weui-BG-2);
  border-radius: 12rpx;
}

.factory-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--weui-FG-0);
}

.factory-switch {
  font-size: 24rpx;
  color: var(--weui-BRAND);
}

.factory-bar:active {
  opacity: 0.7;
}

/* 月份选择器 */
.month-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 24rpx 8rpx;
  gap: 32rpx;
}

.month-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--weui-BRAND);
  background: var(--weui-BG-1);
  border-radius: 50%;
}

.month-arrow:active {
  background: #e0e0e0;
}

.month-arrow-disabled {
  color: var(--weui-FG-2);
  opacity: 0.4;
}

.month-arrow-disabled:active {
  background: var(--weui-BG-1);
}

.month-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--weui-FG-0);
  min-width: 200rpx;
  text-align: center;
}

/* ========== M1 数字总览卡 ========== */
.summary-card {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #fff;
}

.summary-row {
  display: flex;
  align-items: center;
}

.summary-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
}

.summary-num {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.summary-alert {
  color: #FFEB3B;
}

.summary-label {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.summary-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.3);
}

.summary-item.clickable:active {
  opacity: 0.7;
}

/* ========== 通用卡片 ========== */
.dash-card {
  margin-bottom: 4rpx;
}

.dash-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dash-card-title {
  font-size: 30rpx;
  font-weight: 500;
}

.dash-card-link {
  font-size: 24rpx;
  color: var(--weui-BRAND);
}

/* ========== M5 7天趋势图 ========== */
.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 240rpx;
  padding-top: 40rpx;
}

.trend-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  position: relative;
}

.trend-bar-wrap:active {
  opacity: 0.7;
}

.trend-count {
  font-size: 20rpx;
  color: var(--weui-FG-1);
  margin-bottom: 6rpx;
  font-weight: 500;
}

.trend-bar {
  width: 48rpx;
  min-height: 8rpx;
  background: var(--weui-BRAND);
  border-radius: 6rpx 6rpx 0 0;
  transition: height 0.3s ease;
}

.trend-bar-high {
  background: #FA5151;
}

.trend-date {
  font-size: 20rpx;
  color: var(--weui-FG-2);
  margin-top: 8rpx;
}

/* ========== M6 报警设备分布 ========== */
.alert-device-item {
  padding: 16rpx 0;
}

.alert-device-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.alert-count-text {
  color: #FA5151;
  font-weight: 500;
}

/* ========== 排行榜通用 ========== */
.dash-rank-list {
  padding: 0;
}

.dash-rank-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--weui-BG-1);
}

.dash-rank-item:last-child {
  border-bottom: none;
}

.rank-no {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--weui-BRAND);
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
}

.rank-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rank-value {
  font-size: 26rpx;
  color: var(--weui-FG-1);
}

.rank-arrow {
  font-size: 32rpx;
  color: var(--weui-FG-2);
  margin-left: 8rpx;
}

.dash-rank-item.clickable {
  position: relative;
}

.dash-rank-item.clickable:active {
  background: #f5f5f5;
  margin: 0 -24rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

/* ========== 报警统计 ========== */
.alert-summary {
  display: flex;
  margin-top: 16rpx;
  gap: 24rpx;
}

.alert-stat {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: var(--weui-BG-1);
  border-radius: 12rpx;
}

.alert-stat-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.alert-stat-num.open {
  color: #FA5151;
}

.alert-stat-num.ack {
  color: #888;
}

.alert-stat-label {
  font-size: 24rpx;
  color: var(--weui-FG-1);
  margin-top: 4rpx;
}

.alert-stat.clickable {
  border-radius: 12rpx;
  position: relative;
}

.alert-stat.clickable:active {
  opacity: 0.7;
}

/* M7 配件使用金额 */
.cost-card {
  background: linear-gradient(135deg, #fff 0%, #f0f9ff 100%);
}

.cost-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--weui-BG-1);
  margin-bottom: 8rpx;
}

.cost-total-label {
  font-size: 28rpx;
  color: var(--weui-FG-1);
}

.cost-total-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #07C160;
}

.dash-card-subtitle {
  font-size: 24rpx;
  color: var(--weui-FG-1);
}

.cost-rank-list {
  padding: 8rpx 0;
}

.cost-rank-item {
  padding: 12rpx 0;
}

.cost-rank-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.cost-rank-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: var(--weui-BG-1);
  color: var(--weui-FG-1);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cost-rank-item:nth-child(1) .cost-rank-no,
.cost-rank-item:nth-child(2) .cost-rank-no,
.cost-rank-item:nth-child(3) .cost-rank-no {
  background: #07C160;
  color: #fff;
}

.cost-rank-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--weui-FG-0);
}

.cost-rank-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--weui-FG-0);
  flex-shrink: 0;
}

.cost-rank-bar-wrap {
  height: 12rpx;
  background: var(--weui-BG-1);
  border-radius: 6rpx;
  margin-left: 52rpx;
  overflow: hidden;
}

.cost-rank-bar {
  height: 100%;
  background: linear-gradient(90deg, #07C160, #38d976);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.cost-rank-item.clickable:active {
  background: #f5f5f5;
  margin: 0 -24rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

/* ========== 巡检概况卡片 ========== */
.inspect-card {
  background: linear-gradient(135deg, #f0faff 0%, #fff 100%);
}

.inspect-stats {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.inspect-stat {
  flex: 1;
  text-align: center;
}

.inspect-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--weui-FG-0);
  line-height: 1.3;
}

.inspect-num.green { color: #07C160; }
.inspect-num.orange { color: #ED6A0C; }

.inspect-label {
  font-size: 22rpx;
  color: var(--weui-FG-2);
  margin-top: 4rpx;
}

.inspect-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--weui-BG-1);
}

/* 7天日历条 */
.inspect-week {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--weui-BG-1);
}

.iw-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.iw-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--weui-BG-1);
}

.iw-dot.lv1 { background: #b8e6c9; }
.iw-dot.lv2 { background: #5bc77e; }
.iw-dot.lv3 { background: #07C160; }

.iw-day {
  font-size: 20rpx;
  color: var(--weui-FG-2);
}

.iw-col.is-today .iw-day {
  color: var(--weui-BRAND);
  font-weight: 600;
}

.iw-col.is-today .iw-dot {
  box-shadow: 0 0 0 3rpx rgba(7, 193, 96, 0.3);
}

.inspect-empty {
  text-align: center;
  padding: 32rpx 0;
  color: var(--weui-FG-2);
  font-size: 26rpx;
}

/* 首屏加载状态 */
.loading-container {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-container .loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--weui-BG-2);
  border-top-color: var(--weui-BRAND);
  border-radius: 50%;
  animation: dashboard-spin 0.8s linear infinite;
}

@keyframes dashboard-spin {
  to { transform: rotate(360deg); }
}

.loading-container .loading-text {
  font-size: 28rpx;
  color: var(--weui-FG-2);
}
