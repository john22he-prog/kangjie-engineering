<!-- pages/dashboard/index.wxml -->
<custom-nav title="看板" />
<view class="page-container" wx:if="{{!loading}}">
  <!-- 工厂切换 -->
  <view class="factory-bar" wx:if="{{canSwitchFactory}}" bindtap="onSwitchFactory">
    <text class="factory-name">{{currentFactoryName}}</text>
    <text class="factory-switch">切换 ›</text>
  </view>

  <!-- 月份选择器 -->
  <view class="month-picker">
    <view class="month-arrow" bindtap="onPrevMonth">‹</view>
    <view class="month-label">{{yearMonth}}</view>
    <view class="month-arrow {{isCurrentMonth ? 'month-arrow-disabled' : ''}}" bindtap="onNextMonth">›</view>
  </view>

  <!-- M1 本月总览数字卡 -->
  <view class="card dash-card summary-card">
    <view class="summary-row">
      <view class="summary-item">
        <view class="summary-num">{{stats.totalLogs || 0}}</view>
        <view class="summary-label">更换次数</view>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <view class="summary-num">{{stats.totalPartsQty || 0}}</view>
        <view class="summary-label">配件总量</view>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item clickable" bindtap="onOpenAlertsTap">
        <view class="summary-num summary-alert">{{(stats.openAlerts || 0) + inventoryOpenCount}}</view>
        <view class="summary-label">待处理报警 ›</view>
      </view>
    </view>
  </view>

  <!-- M7 当月配件使用金额 TOP 10（仅主管及以上可见） -->
  <view class="card dash-card cost-card" wx:if="{{canViewCost}}">
    <view class="dash-card-header">
      <text class="dash-card-title">当月配件使用金额</text>
    </view>
    <view class="cost-total">
      <text class="cost-total-label">总金额</text>
      <text class="cost-total-value">¥{{costRanking.totalMonthlyUsageCostStr || '0'}}</text>
    </view>
    <view class="dash-card-header" style="margin-top: 16rpx;">
      <text class="dash-card-subtitle">按设备排名 TOP 10（从高到低）</text>
    </view>
    <view class="cost-rank-list">
      <view class="cost-rank-item clickable" wx:for="{{costRanking.costByAsset}}" wx:key="assetId" bindtap="onCostAssetTap" data-item="{{item}}">
        <view class="cost-rank-header">
          <text class="cost-rank-no">{{index + 1}}</text>
          <text class="cost-rank-name">{{item.assetName}}</text>
          <text class="cost-rank-amount">¥{{item.totalCostStr || item.totalCost}}</text>
          <text class="rank-arrow">›</text>
        </view>
        <view class="cost-rank-bar-wrap">
          <view class="cost-rank-bar" style="width: {{item.barWidth || 0}}%;"></view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{!costRanking.costByAsset || costRanking.costByAsset.length === 0}}">暂无使用金额数据</view>
    </view>
  </view>

  <!-- 巡检概况 -->
  <view class="card dash-card inspect-card">
    <view class="dash-card-header">
      <text class="dash-card-title">巡检概况</text>
      <text class="dash-card-link" bindtap="onInspectionTap">详情 ›</text>
    </view>
    <view class="inspect-stats" wx:if="{{inspection.hasPlan}}">
      <view class="inspect-stat">
        <view class="inspect-num {{inspection.todayCompleted >= inspection.todayTotal ? 'green' : ''}}">{{inspection.todayCompleted}}/{{inspection.todayTotal}}</view>
        <view class="inspect-label">今日</view>
      </view>
      <view class="inspect-divider"></view>
      <view class="inspect-stat">
        <view class="inspect-num {{inspection.weekRate >= 80 ? 'green' : 'orange'}}">{{inspection.weekRate}}%</view>
        <view class="inspect-label">本周</view>
      </view>
      <view class="inspect-divider"></view>
      <view class="inspect-stat">
        <view class="inspect-num">{{inspection.streak}}天</view>
        <view class="inspect-label">连续达标</view>
      </view>
    </view>
    <!-- 7天巡检趋势 -->
    <view class="inspect-week" wx:if="{{inspection.hasPlan && inspection.week}}">
      <view class="iw-col {{item.isToday ? 'is-today' : ''}}" wx:for="{{inspection.week}}" wx:key="date">
        <view class="iw-dot lv{{item.level}}"></view>
        <view class="iw-day">{{item.dayName}}</view>
      </view>
    </view>
    <view class="inspect-empty" wx:if="{{!inspection.hasPlan}}">
      <text>未配置巡检计划</text>
    </view>
  </view>

  <!-- M5 最近7天趋势 -->
  <view class="card dash-card" wx:if="{{stats.dailyTrend.length > 0}}">
    <view class="dash-card-header">
      <text class="dash-card-title">最近 7 天更换趋势</text>
    </view>
    <view class="trend-chart">
      <view class="trend-bar-wrap" wx:for="{{stats.dailyTrend}}" wx:key="date" bindtap="onTrendDayTap" data-item="{{item}}">
        <text class="trend-count">{{item.count}}</text>
        <view class="trend-bar {{item.isHigh ? 'trend-bar-high' : ''}}" style="height: {{item.barHeight}}rpx;"></view>
        <text class="trend-date">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- M6 报警设备分布 -->
  <view class="card dash-card" wx:if="{{stats.alertsByAsset.length > 0}}">
    <view class="dash-card-header">
      <text class="dash-card-title">报警设备分布 (OPEN)</text>
      <text class="dash-card-link" bindtap="onOpenAlertsTap">查看全部 ›</text>
    </view>
    <view class="dash-rank-list">
      <view class="dash-rank-item alert-device-item clickable" wx:for="{{stats.alertsByAsset}}" wx:key="assetId" bindtap="onAlertAssetTap" data-item="{{item}}">
        <text class="alert-device-icon">⚠</text>
        <text class="rank-name">{{item.assetName}}</text>
        <view class="rank-right">
          <text class="rank-value alert-count-text">{{item.openCount}} 条报警</text>
          <text class="rank-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 报警统计（超阈值 + 低库存） -->
  <view class="card dash-card">
    <view class="dash-card-header">
      <text class="dash-card-title">阈值报警统计</text>
    </view>
    <view class="alert-summary">
      <view class="alert-stat clickable" bindtap="onOpenAlertsTap">
        <view class="alert-stat-num open">{{stats.openAlerts}}</view>
        <view class="alert-stat-label">超阈值待处理 ›</view>
      </view>
      <view class="alert-stat clickable" bindtap="onInventoryAlertsTap" wx:if="{{inventoryOpenCount > 0}}">
        <view class="alert-stat-num open">{{inventoryOpenCount}}</view>
        <view class="alert-stat-label">低库存预警 ›</view>
      </view>
      <view class="alert-stat clickable" bindtap="onAckAlertsTap">
        <view class="alert-stat-num ack">{{stats.totalAlerts - stats.openAlerts}}</view>
        <view class="alert-stat-label">已确认 ›</view>
      </view>
    </view>
  </view>

  <!-- M2 配件消耗 TOP 10 -->
  <view class="card dash-card">
    <view class="dash-card-header">
      <text class="dash-card-title">配件消耗 TOP 10</text>
    </view>
    <view class="dash-rank-list">
      <view class="dash-rank-item clickable" wx:for="{{stats.topParts}}" wx:key="index" bindtap="onPartTap" data-item="{{item}}">
        <text class="rank-no">{{index + 1}}</text>
        <text class="rank-name">{{item.name}}</text>
        <view class="rank-right">
          <text class="rank-value">{{item.qty}} {{item.unit}}</text>
          <text class="rank-arrow">›</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{stats.topParts.length === 0}}">暂无数据</view>
    </view>
  </view>

  <!-- M3 设备更换 TOP 10 -->
  <view class="card dash-card">
    <view class="dash-card-header">
      <text class="dash-card-title">设备更换 TOP 10</text>
    </view>
    <view class="dash-rank-list">
      <view class="dash-rank-item clickable" wx:for="{{stats.topAssets}}" wx:key="index" bindtap="onAssetTap" data-item="{{item}}">
        <text class="rank-no">{{index + 1}}</text>
        <text class="rank-name">{{item.name}}</text>
        <view class="rank-right">
          <text class="rank-value">{{item.count}} 次</text>
          <text class="rank-arrow">›</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{stats.topAssets.length === 0}}">暂无数据</view>
    </view>
  </view>

  <!-- M4 工程人员工作量 -->
  <view class="card dash-card">
    <view class="dash-card-header">
      <text class="dash-card-title">工程人员工作量</text>
    </view>
    <view class="dash-rank-list">
      <view class="dash-rank-item clickable" wx:for="{{stats.topEngineers}}" wx:key="index" bindtap="onEngineerTap" data-item="{{item}}">
        <text class="rank-no">{{index + 1}}</text>
        <text class="rank-name">{{item.name}}</text>
        <view class="rank-right">
          <text class="rank-value">{{item.count}} 条</text>
          <text class="rank-arrow">›</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{stats.topEngineers.length === 0}}">暂无数据</view>
    </view>
  </view>
</view>
<view class="page-container loading-container" wx:if="{{loading}}">
  <view class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中…</text>
  </view>
</view>
