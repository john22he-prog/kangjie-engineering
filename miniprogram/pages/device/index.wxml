<view class="page">
  <!-- 加载中 -->
  <view class="loading-view" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在识别设备...</text>
  </view>

  <!-- 设备未找到 -->
  <view class="error-view" wx:elif="{{loadError}}">
    <text class="error-icon">!</text>
    <text class="error-title">设备未找到</text>
    <text class="error-desc">请确认二维码是否正确</text>
  </view>

  <!-- 设备信息 + 功能列表 -->
  <block wx:else>
    <view class="asset-card">
      <view class="asset-name">{{assetName}}</view>
      <view class="asset-meta">
        <text wx:if="{{assetNo}}">{{assetNo}}</text>
        <text wx:if="{{assetNo && factoryName}}"> · </text>
        <text wx:if="{{factoryName}}">{{factoryName}}</text>
      </view>
    </view>

    <view class="action-list">
      <!-- 故障申报 - 所有人可见 -->
      <view class="action-item action-fault" bindtap="onFaultReport">
        <view class="action-left">
          <view class="action-icon icon-fault">!</view>
          <view class="action-info">
            <text class="action-title">故障申报</text>
            <text class="action-desc">拍照上报设备故障</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>

      <!-- 更换配件 - 需要 record:write -->
      <view class="action-item" wx:if="{{canReplace}}" bindtap="onReplace">
        <view class="action-left">
          <view class="action-icon icon-replace">R</view>
          <view class="action-info">
            <text class="action-title">更换配件</text>
            <text class="action-desc">记录配件更换信息</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>

      <!-- 巡检打卡 - 需要 inspection:write -->
      <view class="action-item" wx:if="{{canInspect}}" bindtap="onInspect">
        <view class="action-left">
          <view class="action-icon icon-inspect">I</view>
          <view class="action-info">
            <text class="action-title">巡检打卡</text>
            <text class="action-desc">提交设备巡检记录</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>

      <!-- 设备详情 - 需要 module:engineering -->
      <view class="action-item" wx:if="{{canViewDetail}}" bindtap="onViewDetail">
        <view class="action-left">
          <view class="action-icon icon-detail">D</view>
          <view class="action-info">
            <text class="action-title">设备详情</text>
            <text class="action-desc">查看设备信息和历史记录</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>
    </view>

    <!-- 匿名用户绑定入口 -->
    <view class="bind-link" wx:if="{{!isLoggedIn}}" bindtap="onGoBind">
      <text>工程部员工？点击绑定账号 ›</text>
    </view>
  </block>
</view>
