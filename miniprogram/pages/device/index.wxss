.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 24rpx 60rpx;
}

.loading-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 40vh;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

.error-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 35vh;
}

.error-icon {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  border-radius: 50%;
  background: #ff9800;
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
}

.error-title {
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.error-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.asset-card {
  margin-top: 24rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 20rpx;
  color: #fff;
}

.asset-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.asset-meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.action-list {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-item:last-child {
  border-bottom: none;
}

.action-item:active {
  background: #f8f8f8;
}

.action-left {
  display: flex;
  align-items: center;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-fault { background: linear-gradient(135deg, #e74c3c, #c0392b); }
.icon-replace { background: linear-gradient(135deg, #3498db, #2980b9); }
.icon-inspect { background: linear-gradient(135deg, #07C160, #06AD56); }
.icon-detail { background: linear-gradient(135deg, #9b59b6, #8e44ad); }

.action-info {
  display: flex;
  flex-direction: column;
}

.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.action-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.action-arrow {
  font-size: 36rpx;
  color: #ccc;
  flex-shrink: 0;
}

.bind-link {
  text-align: center;
  margin-top: 48rpx;
  font-size: 26rpx;
  color: #576B95;
}
