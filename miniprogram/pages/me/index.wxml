<!-- pages/me/index.wxml -->
<view class="page-container">
  <!-- 用户信息 -->
  <view class="card user-card">
    <view class="user-name">{{userInfo.displayName || '未登录'}}</view>
    <view class="user-role">
      <view class="tag tag-active">{{userInfo.role || '--'}}</view>
    </view>
  </view>

  <!-- 工厂信息 -->
  <view class="card">
    <view class="me-cell" bindtap="{{canSwitchFactory ? 'onSwitchFactory' : ''}}">
      <view class="me-cell-left">
        <view>
          <text class="me-cell-title">当前工厂</text>
          <text class="me-cell-desc">{{currentFactoryName}}</text>
        </view>
      </view>
      <text class="me-cell-arrow" wx:if="{{canSwitchFactory}}">切换 ›</text>
    </view>
  </view>

  <!-- 离线队列 -->
  <offline-banner count="{{offlineCount}}" syncing="{{syncing}}" bind:sync="onSync" />

  <!-- AI 分析报告（主管及以上） -->
  <view class="card" wx:if="{{canManage}}">
    <view class="me-cell" bindtap="onAIAnalysis">
      <view class="me-cell-left">
        <view>
          <text class="me-cell-title">AI 分析报告</text>
          <text class="me-cell-desc">查看数据摘要与风险建议</text>
        </view>
      </view>
      <text class="me-cell-arrow">›</text>
    </view>
  </view>

  <!-- 角色切换（开发测试用，正式上线删除） -->
  <view class="card" wx:if="{{devMode}}">
    <view class="me-cell-header">切换角色（开发调试）</view>
    <view
      class="me-cell {{item.userId === userInfo.userId ? 'me-cell-active' : ''}}"
      wx:for="{{mockUsers}}"
      wx:key="userId"
      bindtap="onSwitchRole"
      data-userid="{{item.userId}}"
    >
      <text>{{item.displayName}}</text>
      <text class="me-cell-value">{{item.role}}</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="card">
    <view class="me-cell" bindtap="onAbout">
      <text>关于</text>
      <text class="me-cell-value">v1.0.0</text>
    </view>
  </view>
</view>
