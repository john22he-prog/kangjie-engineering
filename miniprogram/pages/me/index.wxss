/* pages/me/index.wxss */
/* 返回公司总览 */
.back-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin: -24rpx -24rpx 16rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #fff;
  border-radius: 0 0 16rpx 16rpx;
}

.back-arrow {
  font-size: 40rpx;
  font-weight: 300;
  margin-right: 8rpx;
  line-height: 1;
}

.back-text {
  font-size: 28rpx;
  font-weight: 500;
}

.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.user-role {
  margin-top: 8rpx;
}

.me-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--weui-BG-1);
  font-size: 30rpx;
}

.me-cell:last-child {
  border-bottom: none;
}

.me-cell-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.me-cell-icon {
  font-size: 36rpx;
}

.me-cell-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.me-cell-desc {
  display: block;
  font-size: 22rpx;
  color: var(--weui-FG-2);
  margin-top: 4rpx;
}

.me-cell-value {
  color: var(--weui-FG-2);
  font-size: 28rpx;
}

.me-cell-arrow {
  font-size: 32rpx;
  color: var(--weui-FG-2);
}

.me-cell-header {
  font-size: 26rpx;
  color: var(--weui-FG-1);
  padding: 16rpx 0 8rpx;
  font-weight: 500;
}

.me-cell-active {
  background: #f0faf3;
  margin: 0 -24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
}

.me-cell-active text:first-child {
  color: var(--weui-BRAND);
  font-weight: 600;
}

.logout-cell {
  justify-content: center;
}

.logout-text {
  color: #e74c3c;
  font-size: 30rpx;
  text-align: center;
}
