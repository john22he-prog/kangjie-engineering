/* pages/record/index.wxss */
.filter-bar {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.filter-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 12rpx 0;
}

.filter-label {
  font-size: 22rpx;
  color: var(--weui-FG-2);
}

.filter-value {
  font-size: 28rpx;
  color: var(--weui-FG-0);
  margin-top: 4rpx;
}

.record-item {
  padding: 20rpx 24rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.record-date {
  font-size: 24rpx;
  color: var(--weui-FG-1);
}

.record-reporter {
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

.record-body {
  margin-bottom: 8rpx;
}

.record-asset {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.record-location {
  font-size: 26rpx;
  color: var(--weui-FG-1);
}

.record-footer {
  display: flex;
  justify-content: flex-end;
}

.record-count {
  font-size: 24rpx;
  color: var(--weui-BRAND);
}

.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: var(--weui-FG-2);
  font-size: 26rpx;
}

/* 人员筛选标签 */
.filter-tag-bar {
  padding: 0 24rpx 16rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 20rpx;
  background: #E6F0FF;
  color: #576B95;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.filter-tag-close {
  font-size: 28rpx;
  color: #999;
  padding: 0 4rpx;
}

.filter-tag-close:active {
  color: #333;
}
