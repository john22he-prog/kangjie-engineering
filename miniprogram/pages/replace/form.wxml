<!-- pages/replace/form.wxml -->
<view class="page-container">
  <!-- 固定区（不可编辑） -->
  <view class="card">
    <view class="form-row readonly">
      <text class="form-label">设备ID</text>
      <text class="form-value">{{assetId}}</text>
    </view>
    <view class="form-row readonly">
      <text class="form-label">设备名称</text>
      <text class="form-value">{{assetName}}</text>
    </view>
    <view class="form-row readonly">
      <text class="form-label">设备编号</text>
      <text class="form-value">{{assetNo}}</text>
    </view>
    <view class="form-row readonly">
      <text class="form-label">填报人</text>
      <text class="form-value">{{reporterName}}</text>
    </view>
    <view class="form-row readonly">
      <text class="form-label">提交时间</text>
      <text class="form-value">{{displayDate}}</text>
    </view>
  </view>

  <!-- 处理方式 -->
  <view class="card">
    <view class="form-section-title required">处理方式</view>
    <view class="action-mode-bar">
      <view
        wx:for="{{actionModes}}"
        wx:key="index"
        class="action-mode-item {{actionMode === index ? 'active' : ''}}"
        data-value="{{index}}"
        bindtap="onActionModeChange"
      >{{item}}</view>
    </view>
  </view>

  <!-- ===== 更换配件模式 ===== -->
  <block wx:if="{{!noParts}}">
    <view class="card">
      <picker range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="form-row">
          <text class="form-label required">更换类型</text>
          <text class="form-value {{type ? '' : 'placeholder'}}">{{type || '请选择更换类型'}}</text>
        </view>
      </picker>

      <view wx:if="{{hasLocations}}">
        <picker range="{{locations}}" range-key="locationName" value="{{locationIndex}}" bindchange="onLocationChange">
          <view class="form-row">
            <text class="form-label">部位（选填）</text>
            <text class="form-value {{locationId ? '' : 'placeholder'}}">{{locationName || '不选择则显示全部配件'}}</text>
          </view>
        </picker>
        <view class="form-row" wx:if="{{locationId}}" bindtap="onClearLocation" style="justify-content:flex-end;">
          <text style="font-size:24rpx;color:#576b95;">清除部位筛选</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="form-section-title">选择配件</view>
      <sku-multi-select
        availableSkus="{{availableSkus}}"
        value="{{selectedSkus}}"
        readonly="{{false}}"
        bind:change="onSkuChange"
      />
    </view>
  </block>

  <!-- ===== 无需换件模式 ===== -->
  <block wx:if="{{noParts}}">
    <view class="card">
      <picker range="{{fixTypeOptions}}" value="{{fixTypeIndex}}" bindchange="onFixTypeChange">
        <view class="form-row">
          <text class="form-label required">故障处理类型</text>
          <text class="form-value {{fixType ? '' : 'placeholder'}}">{{fixType || '请选择处理类型'}}</text>
        </view>
      </picker>
    </view>
  </block>

  <!-- 备注 -->
  <view class="card">
    <view class="form-section-title {{noParts ? 'required' : ''}}">{{noParts ? '处理说明' : '备注'}}</view>
    <textarea
      class="form-textarea"
      placeholder="{{noParts ? '请说明具体做了什么处理（必填）' : '选填备注说明'}}"
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="500"
    />
  </view>

  <!-- 图片上传 -->
  <view class="card">
    <view class="form-section-title required">上传照片（至少1张）</view>
    <image-uploader
      minCount="{{1}}"
      maxCount="{{9}}"
      value="{{images}}"
      readonly="{{false}}"
      bind:change="onImageChange"
    />
  </view>

  <!-- 放弃 / 提交 -->
  <view class="submit-bar">
    <view class="abandon-link" bindtap="onAbandonTap">放弃并返回</view>
    <button
      class="btn-primary submit-btn"
      disabled="{{!canSubmit || submitting}}"
      loading="{{submitting}}"
      bindtap="onSubmit"
    >提交</button>
  </view>
</view>
