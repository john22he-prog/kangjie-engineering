/* pages/scan/index.wxss */
.scan-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 35vh;
  padding-bottom: 40rpx;
  min-height: 60vh;
}

.scan-btn {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07C160, #06AD56);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.35);
}

.scan-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.scan-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.scan-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

/* 开发模式 */
.dev-entry {
  margin-top: 20rpx;
}

.dev-btn {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--weui-BG-1);
  font-size: 28rpx;
  color: #576B95;
}

.dev-btn:active {
  background: #f0f0f0;
}

.dev-btn:last-child {
  border-bottom: none;
}

/* 故障申报入口 */
.fault-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.fault-entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #e74c3c;
}

.fault-entry-desc {
  display: block;
  font-size: 22rpx;
  color: var(--weui-FG-2);
  margin-top: 4rpx;
}

.fault-entry-arrow {
  font-size: 32rpx;
  color: var(--weui-FG-2);
}

/* 匿名用户界面 */
.anon-hero {
  text-align: center;
  padding: 100rpx 0 60rpx;
}

.anon-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #07C160;
}

.anon-subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 12rpx;
}

.anon-main-btn {
  width: 560rpx;
  margin: 60rpx auto;
  padding: 48rpx 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(231, 76, 60, 0.35);
}

.anon-main-btn:active { opacity: 0.85; transform: scale(0.97); }

.anon-btn-text {
  display: block;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.anon-btn-hint {
  display: block;
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  margin-top: 12rpx;
}

.anon-login-link {
  text-align: center;
  margin-top: 60rpx;
  font-size: 26rpx;
  color: #576B95;
}
