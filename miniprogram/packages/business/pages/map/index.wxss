.map-page {
  width: 100%;
  height: 100vh;
  position: relative;
}

.map-container {
  width: 100%;
  height: 100%;
}

/* 顶部工具栏 */
.map-toolbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: calc(env(safe-area-inset-top) + 88rpx) 24rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.toolbar-left {
  background: rgba(255,255,255,0.95);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.hotel-count {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.toolbar-right {
  display: flex;
  gap: 16rpx;
}

.toolbar-btn {
  background: rgba(255,255,255,0.95);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  font-size: 26rpx;
  color: #333;
}

.toolbar-btn.primary {
  background: #07C160;
  color: #fff;
}

/* 空状态 */
.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  background: rgba(255,255,255,0.95);
  padding: 60rpx 80rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.1);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  display: block;
  margin-bottom: 30rpx;
}

.empty-btn {
  background: #07C160;
  color: #fff;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: inline-block;
}

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 200;
}

.detail-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 300;
}

.detail-panel.show {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.detail-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.detail-body {
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.detail-label {
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.detail-value {
  color: #333;
  flex: 1;
}

.detail-value.phone {
  color: #07C160;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.action-btn.navigate {
  background: #07C160;
  color: #fff;
}
