.review-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.review-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.review-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.rs-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rs-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}

.rs-num.suggest { color: #E6A23C; }
.rs-num.high { color: #07C160; }

.rs-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.accept-all-btn {
  background: #07C160;
  color: #fff;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.accept-all-btn.disabled {
  background: #c8c9cc;
}

.review-tip {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  padding: 0 8rpx 16rpx;
}

.loading-tip, .empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.review-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.hotel-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.level-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.level-tag.high { background: #e8f5e9; color: #07C160; }
.level-tag.medium { background: #fff3e0; color: #E6A23C; }
.level-tag.none { background: #f5f5f5; color: #999; }

.hotel-addr {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.poi-box {
  background: #f0f7ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.poi-box.empty {
  background: #fafafa;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.poi-arrow {
  font-size: 22rpx;
  color: #409EFF;
  margin-bottom: 8rpx;
}

.poi-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.poi-addr {
  font-size: 24rpx;
  color: #666;
}

.poi-tel {
  font-size: 24rpx;
  color: #409EFF;
  margin-top: 6rpx;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 20rpx;
}

.act-btn {
  padding: 14rpx 36rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.act-btn.primary {
  background: #07C160;
  color: #fff;
}

.act-btn.ghost {
  background: #f0f0f0;
  color: #666;
}

.act-btn.disabled {
  background: #c8c9cc;
  color: #fff;
}

.status-done {
  color: #07C160;
  font-size: 28rpx;
}

.status-ignored {
  color: #999;
  font-size: 28rpx;
}
