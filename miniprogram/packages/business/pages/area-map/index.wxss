.area-page {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.map-container {
  width: 100%;
  height: 100%;
}

/* 顶部搜索栏 */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: calc(env(safe-area-inset-top) + 88rpx) 24rpx 0;
  z-index: 100;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 64rpx;
}

.search-btn {
  background: #409EFF;
  color: #fff;
  font-size: 28rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 12rpx;
}

.settings-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  color: #666;
}

.mode-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mode-tab {
  flex: 1;
  background: rgba(255,255,255,0.95);
  border-radius: 12rpx;
  padding: 14rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.mode-tab.active {
  background: #409EFF;
  color: #fff;
}

/* 设置面板 */
.settings-panel {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 260rpx);
  left: 24rpx;
  right: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  z-index: 99;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
}

.setting-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-label {
  width: 180rpx;
  font-size: 26rpx;
  color: #333;
  flex-shrink: 0;
}

.setting-input {
  flex: 1;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}

.setting-hint {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 绘制工具栏 */
.draw-toolbar {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  left: 24rpx;
  right: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  z-index: 150;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.draw-tip {
  font-size: 26rpx;
  color: #333;
}

.draw-actions {
  display: flex;
  gap: 16rpx;
}

.draw-btn {
  font-size: 26rpx;
  color: #666;
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
}

.draw-btn.primary {
  background: #409EFF;
  color: #fff;
}

/* 统计条 */
.stats-bar {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 250rpx);
  left: 24rpx;
  right: 24rpx;
  background: rgba(255,255,255,0.96);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  flex-wrap: wrap;
}

.stat-chip {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.stat-chip.total { background: #f0f0f0; color: #333; }
.stat-chip.bound { background: #e8f5e9; color: #07C160; }
.stat-chip.suggested { background: #fff3e0; color: #E6A23C; }
.stat-chip.unmatched { background: #f5f5f5; color: #999; }

.stat-expand {
  margin-left: auto;
  font-size: 24rpx;
  color: #409EFF;
}

/* 浮动操作 */
.float-actions {
  position: fixed;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 200rpx);
  z-index: 80;
}

.float-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.float-btn {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #333;
}

.float-btn.active {
  background: #8E44AD;
  color: #fff;
}

.float-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 6rpx;
  background: #E6A23C;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  text-align: center;
}

.load-more {
  text-align: center;
  padding: 28rpx 0;
  color: #409EFF;
  font-size: 28rpx;
}

/* 列表面板 */
.list-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 200;
}

.list-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 300;
  display: flex;
  flex-direction: column;
}

.list-panel.show {
  transform: translateY(0);
}

.list-tabs {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 16rpx 0;
}

.list-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 12rpx 0;
}

.list-tab.active {
  color: #409EFF;
  font-weight: 600;
}

.list-scroll {
  flex: 1;
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-left {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.item-addr {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.item-tel {
  font-size: 24rpx;
  color: #409EFF;
}

.item-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-tag.bound { background: #e8f5e9; color: #07C160; }
.status-tag.suggested { background: #fff3e0; color: #E6A23C; }
.status-tag.unmatched { background: #f5f5f5; color: #999; }

.list-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 400;
}

.detail-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 500;
  max-height: 80vh;
  overflow-y: auto;
}

.detail-panel.show {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.detail-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

/* 匹配横幅 */
.match-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  margin-bottom: 24rpx;
}

.match-banner.bound { background: #e8f5e9; }
.match-banner.suggested { background: #fff3e0; }
.match-banner.unmatched { background: #f5f5f5; }

.match-icon {
  font-size: 40rpx;
}

.match-text {
  display: flex;
  flex-direction: column;
}

.match-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.match-sub {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 匹配度明细 */
.score-detail {
  background: #fafafa;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.score-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.score-row:last-child {
  margin-bottom: 0;
}

.score-label {
  width: 80rpx;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.score-bar {
  flex: 1;
  height: 12rpx;
  background: #e8e8e8;
  border-radius: 6rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.score-fill {
  height: 100%;
  background: #409EFF;
  border-radius: 6rpx;
}

.score-fill.muted {
  background: #ccc;
}

.score-val {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: #333;
  flex-shrink: 0;
}

/* 详情信息 */
.detail-body {
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.detail-label {
  color: #999;
  width: 100rpx;
  flex-shrink: 0;
}

.detail-value {
  color: #333;
  flex: 1;
}

.detail-value.phone {
  color: #409EFF;
}

/* 操作按钮 */
.detail-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.action-btn.primary {
  background: #409EFF;
  color: #fff;
}

.action-btn.ghost {
  background: #f0f0f0;
  color: #333;
}

.action-btn.danger {
  background: #fef0f0;
  color: #f56c6c;
}
