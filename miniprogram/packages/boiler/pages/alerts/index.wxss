page {
  --theme-color: #E65100;
  --theme-light: #FFF3E0;
}

.page-container {
  padding-bottom: 40rpx;
}

/* ========== 筛选栏 ========== */
.filter-bar {
  display: flex;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.filter-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: var(--theme-light);
  border-radius: 8rpx;
}

.filter-text {
  font-size: 26rpx;
  color: var(--theme-color);
  font-weight: 500;
}

.filter-arrow {
  font-size: 22rpx;
  color: var(--theme-color);
  margin-left: 8rpx;
}

/* ========== 预警卡片 ========== */
.alert-list {
  padding-top: 8rpx;
}

.alert-card {
  margin: 16rpx 24rpx;
  padding: 0;
  overflow: hidden;
}

.alert-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* 严重程度标签 */
.alert-severity {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.severity-high {
  background: #FFEBEE;
  color: #D32F2F;
}

.severity-medium {
  background: #FFF3E0;
  color: #E65100;
}

.severity-low {
  background: #E8F5E9;
  color: #2E7D32;
}

/* 状态标签 */
.alert-status {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-open {
  background: #FFEBEE;
  color: #D32F2F;
}

.status-ack {
  background: #FFF8E1;
  color: #F57F17;
}

.status-resolved {
  background: #E8F5E9;
  color: #2E7D32;
}

/* 内容 */
.alert-body {
  padding: 20rpx 24rpx;
}

.alert-rule {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.alert-metric {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.alert-metric-label {
  color: #999;
}

.alert-detail-row {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.alert-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 操作按钮 */
.alert-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.alert-action-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.ack-btn {
  background: #FFF3E0;
  color: #E65100;
}

.resolve-btn {
  background: #E8F5E9;
  color: #2E7D32;
}

/* ========== 通用状态 ========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: var(--theme-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #999;
}
