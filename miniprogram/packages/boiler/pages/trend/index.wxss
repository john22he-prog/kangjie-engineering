page {
  --theme-color: #E65100;
  --theme-light: #FFF3E0;
}

.page-container {
  padding-bottom: 40rpx;
}

/* ========== 筛选栏 ========== */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.filter-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.filter-btn.primary-filter {
  background: var(--theme-light);
}

.filter-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.primary-filter .filter-text {
  color: var(--theme-color);
}

.filter-arrow {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.primary-filter .filter-arrow {
  color: var(--theme-color);
}

/* ========== 图表区域 ========== */
.chart-section {
  padding: 24rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.chart-unit {
  font-size: 24rpx;
  color: #999;
}

.chart-max {
  text-align: right;
  margin-bottom: 8rpx;
}

.chart-max-label {
  font-size: 22rpx;
  color: #bbb;
}

/* ========== 柱状图 ========== */
.chart-scroll {
  white-space: nowrap;
  margin-bottom: 32rpx;
}

.chart-bars {
  display: inline-flex;
  align-items: flex-end;
  height: 360rpx;
  padding: 0 8rpx;
  gap: 4rpx;
  min-width: 100%;
}

.bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 60rpx;
}

.bar-value {
  font-size: 18rpx;
  color: #666;
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.bar-wrapper {
  width: 100%;
  max-width: 48rpx;
  height: 260rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 100%;
  background: linear-gradient(to top, #E65100, #FF8A65);
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s ease;
}

.bar-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  white-space: nowrap;
}

/* ========== 数据表格 ========== */
.data-table {
  margin-top: 16rpx;
  padding: 0;
  overflow: hidden;
}

.table-header {
  display: flex;
  background: rgba(230, 81, 0, 0.06);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.table-header .table-cell {
  font-weight: 600;
  color: #666;
  font-size: 24rpx;
}

.table-row {
  display: flex;
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  font-size: 26rpx;
  color: #333;
}

.date-cell {
  flex: 1;
}

.value-cell {
  flex: 1;
  text-align: right;
  font-weight: 500;
}

/* ========== 通用状态 ========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: var(--theme-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
}
