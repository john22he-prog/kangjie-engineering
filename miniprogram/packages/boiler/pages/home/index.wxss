.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #eee;
  border-top-color: #E65100;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* ===== 未登录 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 260rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  padding: 0 80rpx;
  line-height: 1.6;
}

.btn-retry {
  margin-top: 48rpx;
  padding: 16rpx 56rpx;
  background: #E65100;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* ===== 错误提示 ===== */
.error-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF3E0;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #E65100;
}

.error-retry {
  color: #E65100;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border: 1rpx solid #E65100;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* ===== 头部 ===== */
.header {
  background: linear-gradient(135deg, #E65100, #FF8A65);
  padding: 40rpx 32rpx 48rpx;
  color: #fff;
}

.header-date {
  font-size: 26rpx;
  opacity: 0.85;
}

.header-factory {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 12rpx;
}

.header-overview-date {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 8rpx;
}

/* ===== 统计卡片网格 ===== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 24rpx 24rpx 0;
  margin-top: -24rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}

.stat-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.stat-card.highlight {
  border-left: 6rpx solid #E65100;
}

.stat-sub {
  font-size: 22rpx;
  color: #E65100;
  margin-top: 8rpx;
  display: block;
}

/* ===== 快捷操作 ===== */
.actions {
  display: flex;
  gap: 20rpx;
  padding: 32rpx 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.action-btn.primary {
  background: #E65100;
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #E65100;
  border: 2rpx solid #E65100;
}

.action-btn.outline {
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
}

.action-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.action-text {
  font-size: 30rpx;
}

/* ===== 底部占位 ===== */
.bottom-space {
  height: 40rpx;
}
