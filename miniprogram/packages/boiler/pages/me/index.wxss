/* packages/boiler/pages/me/index.wxss - 锅炉房我的页（橙色主题 #E65100） */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 用户信息卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(230, 81, 0, 0.08);
  margin-bottom: 24rpx;
}

.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
}

.avatar-wrap {
  margin-bottom: 24rpx;
}

.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E65100 0%, #FF8F00 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(230, 81, 0, 0.3);
}

.avatar-char {
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
}

.user-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.user-role {
  margin-bottom: 8rpx;
}

.role-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #E65100;
  background: rgba(230, 81, 0, 0.12);
  border-radius: 20rpx;
}

.user-factory {
  font-size: 26rpx;
  color: #666;
}

/* 菜单卡片 */
.menu-card {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  font-weight: 500;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #bbb;
}
