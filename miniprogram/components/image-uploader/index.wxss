/* components/image-uploader */
.uploader-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.uploader-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploader-img {
  width: 100%;
  height: 100%;
}

.uploader-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,.5);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 12rpx;
}

.uploader-retry {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(250,81,81,.85);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  padding: 8rpx 0;
}

.uploader-loading {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,.5);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  padding: 8rpx 0;
}

.uploader-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.uploader-add:active {
  background: #f7f7f7;
}

.uploader-add-icon {
  font-size: 56rpx;
  color: #ccc;
  line-height: 1;
}

.uploader-add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.uploader-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(0,0,0,.3);
}
