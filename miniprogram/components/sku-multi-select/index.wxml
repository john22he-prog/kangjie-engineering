<!-- components/sku-multi-select -->
<view class="sku-select">
  <!-- 添加配件按钮 -->
  <view class="sku-add-btn" bindtap="openPicker" wx:if="{{!readonly}}">
    <text class="sku-add-icon">+</text>
    <text class="sku-add-text">选择配件 ({{selectedCount}}/{{availableSkus.length}})</text>
  </view>

  <!-- 已选配件列表 -->
  <view class="sku-list" wx:if="{{innerValue.length > 0}}">
    <view class="sku-item" wx:for="{{innerValue}}" wx:key="partSkuId">
      <view class="sku-info">
        <text class="sku-name">{{item.partName}}</text>
        <text class="sku-code">{{item.partCode}}</text>
      </view>
      <view class="sku-qty-row">
        <view class="stepper" wx:if="{{!readonly}}">
          <view class="stepper-btn" bindtap="onMinus" data-index="{{index}}">-</view>
          <input
            class="stepper-input"
            type="number"
            value="{{item.qty}}"
            bindinput="onQtyInput"
            data-index="{{index}}"
          />
          <view class="stepper-btn" bindtap="onPlus" data-index="{{index}}">+</view>
        </view>
        <text class="sku-unit">{{item.unit}}</text>
        <view class="sku-remove" bindtap="onRemove" data-index="{{index}}" wx:if="{{!readonly}}">✕</view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="sku-empty" wx:if="{{innerValue.length === 0 && availableSkus.length > 0}}">
    <text>请选择配件</text>
  </view>

  <!-- 选择弹窗 -->
  <view class="sku-mask" wx:if="{{showPicker}}" bindtap="closePicker"></view>
  <view class="sku-picker {{showPicker ? 'show' : ''}}">
    <view class="picker-header">
      <text class="picker-title">选择配件</text>
      <text class="picker-done" bindtap="closePicker">完成</text>
    </view>
    <!-- 搜索栏 -->
    <view class="picker-search">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="搜索配件名称/编号/规格"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          confirm-type="search"
          focus="{{showPicker}}"
        />
        <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="onClearSearch">✕</text>
      </view>
      <view class="search-stats">
        <text>共 {{filteredPickerItems.length}} 项</text>
        <text wx:if="{{selectedPickerCount > 0}}" class="search-selected-count">已选 {{selectedPickerCount}} 项</text>
      </view>
    </view>
    <view class="picker-list">
      <view
        class="picker-item {{item.selected ? 'selected' : ''}}"
        wx:for="{{filteredPickerItems}}"
        wx:key="partSkuId"
        bindtap="toggleItem"
        data-sku-id="{{item.partSkuId}}"
      >
        <view class="picker-check">{{item.selected ? '☑' : '☐'}}</view>
        <view class="picker-info">
          <text class="picker-name">{{item.partName}}</text>
          <text class="picker-code">{{item.partCode}}{{item.specModel ? ' · ' + item.specModel : ''}} · {{item.unit}}</text>
        </view>
      </view>
      <view class="picker-empty" wx:if="{{filteredPickerItems.length === 0}}">
        <text>未找到匹配的配件</text>
      </view>
    </view>
  </view>
</view>
