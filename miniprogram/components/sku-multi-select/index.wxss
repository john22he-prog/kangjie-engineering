/* components/sku-multi-select */
.sku-select {
  position: relative;
}

.sku-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.sku-add-btn:active {
  background: #f7f7f7;
}

.sku-add-icon {
  font-size: 36rpx;
  color: #07C160;
  margin-right: 12rpx;
  font-weight: 600;
}

.sku-add-text {
  font-size: 28rpx;
  color: #07C160;
}

.sku-list {
  /* list */
}

.sku-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.sku-item:last-child {
  border-bottom: none;
}

.sku-info {
  flex: 1;
  min-width: 0;
}

.sku-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #000;
}

.sku-code {
  display: block;
  font-size: 22rpx;
  color: rgba(0,0,0,.4);
  margin-top: 4rpx;
}

.sku-qty-row {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  background: #f7f7f7;
}

.stepper-btn:active {
  background: #e5e5e5;
}

.stepper-input {
  width: 72rpx;
  height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  border-left: 1rpx solid #ddd;
  border-right: 1rpx solid #ddd;
  min-height: 0;
}

.sku-unit {
  font-size: 24rpx;
  color: rgba(0,0,0,.5);
  margin-left: 8rpx;
  margin-right: 12rpx;
}

.sku-remove {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FA5151;
}

.sku-empty {
  text-align: center;
  padding: 32rpx;
  color: rgba(0,0,0,.3);
  font-size: 26rpx;
}

/* 弹窗遮罩 */
.sku-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,.5);
  z-index: 999;
}

/* 底部弹窗 */
.sku-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.sku-picker.show {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
}

.picker-done {
  font-size: 28rpx;
  color: #07C160;
  font-weight: 500;
}

/* 搜索栏 */
.picker-search {
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 44rpx;
  min-height: 0;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

.search-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(0,0,0,.4);
}

.search-selected-count {
  color: #07C160;
  font-weight: 500;
}

.picker-list {
  max-height: 50vh;
  overflow-y: auto;
  padding: 0 32rpx;
}

.picker-empty {
  text-align: center;
  padding: 48rpx 0;
  color: rgba(0,0,0,.3);
  font-size: 26rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-item.selected {
  background: #f0faf3;
  margin: 0 -32rpx;
  padding: 24rpx 32rpx;
}

.picker-check {
  font-size: 36rpx;
  margin-right: 16rpx;
  color: #07C160;
}

.picker-info {
  flex: 1;
}

.picker-name {
  display: block;
  font-size: 28rpx;
}

.picker-code {
  display: block;
  font-size: 22rpx;
  color: rgba(0,0,0,.4);
  margin-top: 4rpx;
}
