# 小程序 AppID（在微信公众平台→开发→开发管理→开发设置里查看）
APPID=wx3e10fc82cc0af56d

# 小程序 AppSecret（同上位置，点「重置」可重新生成）
# ⚠️ Secret 是敏感信息，不要提交到代码库
SECRET=你的AppSecret

# 云开发环境 ID
ENV=cloud1-0g0grbwt8c230b0d

# 服务端口
PORT=3001

# CORS 允许的前端域名（逗号分隔，默认 localhost:3000 和 localhost:5173）
# 部署后请改为正式域名，例如：
# CORS_ORIGINS=https://your-static-site.tcloudbaseapp.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
